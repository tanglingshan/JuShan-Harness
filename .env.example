# Browser calls this server-side authentication API. Keep the database URL
# server-only; never expose it through VITE_* variables.
VITE_AUTH_API_URL=/api/auth

# Configure this in the process that serves the auth API when the remote
# database is ready (PostgreSQL, MySQL, or the adapter you choose).
AUTH_DATABASE_URL=postgresql://user:password@db.example.com:5432/dsh
